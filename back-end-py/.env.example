# Copy this file to .env and fill in your values
# IMPORTANT: Use 127.0.0.1, not localhost — Windows resolves localhost to IPv6 (::1)
# but MongoDB and FastAPI both bind to IPv4.

MONGO_URI=mongodb://127.0.0.1:27017/knowledgegraph
DB_NAME=knowledgegraph
JWT_SECRET=change_me_before_use
JWT_EXPIRES_DAYS=7
CLIENT_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@knowledgegraph.io
ADMIN_PASSWORD=Admin@1234
GOOGLE_CLIENT_ID=your-google-oauth-client-id-here

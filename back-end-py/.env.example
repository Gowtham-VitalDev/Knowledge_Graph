# Copy this file to .env and fill in your values

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "development" locally — controls SameSite cookie behavior.
# Leave unset (defaults to production) on Cloud Run.
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: use 127.0.0.1 (not localhost — Windows resolves localhost to IPv6)
# Production: use Atlas mongodb+srv:// connection string
MONGO_URI=mongodb://127.0.0.1:27017/knowledgegraph
DB_NAME=knowledgegraph

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_before_use
JWT_EXPIRES_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── Admin seed credentials ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@knowledgegraph.io
ADMIN_PASSWORD=Admin@1234

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id-here

# ── GCS Image Storage ─────────────────────────────────────────────────────────
GCS_BUCKET_NAME=kg-article-images-gg
# Path to service account JSON key (local dev only).
# Leave empty on Cloud Run — Workload Identity handles auth automatically.
GCS_KEY_PATH=
